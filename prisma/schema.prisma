generator client {
  provider = "prisma-client-js"
  // "native" = this machine; rhel-openssl-3.0.x = Netlify/Vercel serverless runtime (Amazon Linux)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Size {
  SMALL
  MEDIUM
  BIG
}

enum ExpenseCategory {
  RENT
  LABOUR
  PETROL
  BIKE_MAINTENANCE
  FEED
  OTHER
}

enum PaymentMode {
  CASH
  ONLINE
}

model SuperAdmin {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  mobile       String   @unique @db.VarChar(15)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("super_admin")
}

model Store {
  id           Int      @id @default(autoincrement())
  storeName    String   @map("store_name") @db.VarChar(100)
  ownerName    String   @map("owner_name") @db.VarChar(100)
  mobile       String   @unique @db.VarChar(15)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  address      String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  purchases        Purchase[]
  expenses         Expense[]
  customers        Customer[]
  sales            Sale[]
  customerPayments CustomerPayment[]

  @@map("stores")
}

model Purchase {
  id           Int      @id @default(autoincrement())
  storeId      Int      @map("store_id")
  date         DateTime @db.Date
  size         Size
  pieces       Int
  weightKg     Decimal  @map("weight_kg") @db.Decimal(10, 3)
  ratePerKg    Decimal  @map("rate_per_kg") @db.Decimal(10, 2)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(12, 2)
  supplierName String?  @map("supplier_name") @db.VarChar(100)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@map("purchases")
}

model Expense {
  id          Int             @id @default(autoincrement())
  storeId     Int             @map("store_id")
  date        DateTime        @db.Date
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
  @@map("expenses")
}

model Customer {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  name        String   @db.VarChar(100)
  mobile      String?  @db.VarChar(15)
  address     String?  @db.VarChar(255)
  defaultSize Size?    @map("default_size")
  defaultRate Decimal? @map("default_rate") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments CustomerPayment[]

  @@unique([storeId, mobile])
  @@index([storeId])
  @@map("customers")
}

model Sale {
  id           Int         @id @default(autoincrement())
  storeId      Int         @map("store_id")
  customerId   Int?        @map("customer_id")
  customerName String      @map("customer_name") @db.VarChar(100)
  date         DateTime    @db.Date
  size         Size
  pieces       Int
  weightKg     Decimal     @map("weight_kg") @db.Decimal(10, 3)
  ratePerKg    Decimal     @map("rate_per_kg") @db.Decimal(10, 2)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  paidAmount   Decimal     @map("paid_amount") @db.Decimal(12, 2)
  paymentMode  PaymentMode @map("payment_mode")
  note         String?     @db.VarChar(255)
  createdAt    DateTime    @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
  @@index([customerId])
  @@map("sales")
}

model CustomerPayment {
  id          Int         @id @default(autoincrement())
  storeId     Int         @map("store_id")
  customerId  Int         @map("customer_id")
  date        DateTime    @db.Date
  amount      Decimal     @db.Decimal(12, 2)
  paymentMode PaymentMode @map("payment_mode")
  note        String?     @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
  @@index([customerId])
  @@map("customer_payments")
}
