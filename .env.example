# MySQL connection string
# Local:      mysql://USER:PASSWORD@localhost:3306/poultry_app
# TiDB Cloud: mysql://USER:PASSWORD@HOST:4000/poultry_app?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/poultry_app"

# Secret used to sign login sessions (min 32 characters).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Super admin account created by `npm run db:seed`
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_MOBILE="9999999999"
SUPERADMIN_PASSWORD="admin@123"
